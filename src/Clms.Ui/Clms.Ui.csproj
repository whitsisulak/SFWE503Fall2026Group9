<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Clms.Ui</RootNamespace>
    <!-- Razor Class Library: these components are consumed by BOTH the Blazor
         WebAssembly host (Clms.Web) and, later, a MAUI Blazor Hybrid host. -->
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clms.Shared\Clms.Shared.csproj" />
  </ItemGroup>

</Project>
